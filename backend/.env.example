# Engram Backend Environment Configuration (OPTIONAL)
# Copy to .env only if you need to override these defaults.
# All user-configurable settings (MakeMKV path, library paths, TMDB token,
# feature flags, etc.) are stored in the database and managed via the
# Settings page in the web UI.

# Database
DATABASE_URL=sqlite+aiosqlite:///./engram.db

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Post-organize encoding hook (fork; see CODEC-CLASSIFIER.md).
# These were ENGRAM_AV1_* before the hook was renamed. The old names are not
# read, and the app refuses to start while any ENGRAM_AV1_* key is set.
# ENGRAM_ENCODE_HOOK=1
# ENGRAM_ENCODE_STAGING=/staging/encode-out
# ENGRAM_ENCODE_CRF=22
# ENGRAM_ENCODE_PRESET=6
# ENGRAM_ENCODE_THREADS=4
# ENGRAM_ENCODE_MAX_CONCURRENT=1
